# MonFolio Frontend — Variables d'environnement
# Copiez ce fichier en .env.local et ajustez les valeurs

# URL de l'API Laravel (sans slash final)
VITE_API_URL=http://localhost:8000/api

# URL du frontend (pour les redirections OAuth)
VITE_APP_URL=http://localhost:5173

# Nom de l'app (affiché dans les titres)
VITE_APP_NAME=MonFolio
